---
import MainLayout from "../layouts/MainLayout.astro";
import TeamCard from "../components/TeamCard.jsx";
import { team } from "../utils/content.js";
import { toParagraphs } from "../utils/contentHelpers.js";
import about from "../data/about.json";
---

<MainLayout>
  <div class="px-4 max-w-5xl 2xl:max-w-7xl mx-auto py-8">
    <h1 class="text-5xl font-bold mb-2">About Us</h1>
    <div class="px-10 max-w-7xl mx-auto py-16">
      <div class="text-xl">
        {toParagraphs(about.aboutText).map((p) => (
          <p class="mb-4">{p}</p>
        ))}
      </div>
    </div>
    <h1 class="text-5xl font-bold mb-2">Meet The Team</h1>
    <br />
    <div class="grid grid-cols-1 md:grid-cols-3 2xl:grid-cols-4 gap-4 mb-4">
      {team.map((member) => (
        <TeamCard
          name={member.name}
          headshot={member.headshot}
          title={member.title}
          bio={member.bio}
          linkedin={member.linkedin}
          client:load
        />
      ))}
    </div>
  </div>
</MainLayout>
