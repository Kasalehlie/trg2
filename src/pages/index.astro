---
import MainLayout from "../layouts/MainLayout.astro";
import Hero from "../components/Hero.jsx";
import StatsSection from "../components/StatsSection.jsx";
import ProjectSection from "../components/ProjectSection.jsx";
import BlogSection from "../components/BlogSection.jsx";
import { news, formatNewsDate } from "../utils/content.js";
---

<MainLayout>
  <main>
    <Hero client:load />

    <StatsSection client:load />
    <ProjectSection client:load />

    <div class="px-4 max-w-5xl 2xl:max-w-7xl mx-auto py-8">
      <h1 class="text-3xl font-bold mb-1">Latest News</h1>
      <a class="text-gray-400" href="/news">All Articles</a>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-4">
        {news
          .slice(0, 3)
          .map((article) => (
            <BlogSection
              title={article.title}
              link={article.link}
              type={article.type}
              description={article.description}
              image={article.image}
              author={article.author}
              date={formatNewsDate(article.date)}
              datetime={article.date}
            />
          ))}
      </div>
    </div>
  </main>
</MainLayout>
